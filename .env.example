# ═══════════════════════════════════════════════════════════════
#  Heimdall OSINT Engine — Environment Configuration Reference
# ═══════════════════════════════════════════════════════════════
#  Copy to .env and fill in values. All fields are optional;
#  zero-key transforms will run automatically without any keys.
# ═══════════════════════════════════════════════════════════════

# ── OSINT API Keys ───────────────────────────────────────────────
# Optional: Shodan REST API key — enables deep banner + CVE enrichment
SHODAN_API_KEY=

# Optional: VirusTotal API v3 key — enables reputation/passive-DNS lookups
# Without this key, the VirusTotal transform is automatically skipped (SKIPPED status)
VIRUSTOTAL_API_KEY=

# Optional: AbuseIPDB API key — enables IP abuse confidence scores
# Free tier available at https://www.abuseipdb.com/register
# Without this key, the AbuseIPDB transform is automatically skipped
ABUSEIPDB_API_KEY=

# ── Neo4j Graph Database ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ── API Security ─────────────────────────────────────────────────
# Optional: Set a bearer token to protect API endpoints.
# When set, all requests must include: Authorization: Bearer <token>
# Leave blank to disable authentication (development mode).
HEIMDALL_AUTH_TOKEN=

# ── Investigation Persistence ────────────────────────────────────
# Set to true to persist investigation graphs to SQLite across restarts
HEIMDALL_PERSIST=false
# Path to the SQLite database file (relative or absolute)
SQLITE_DB_PATH=heimdall_investigations.db

# ── Transform Result Cache ───────────────────────────────────────
# Master cache toggle (true/false)
CACHE_ENABLED=true
# How long (seconds) to cache a successful transform result
CACHE_TTL_SECONDS=3600
# Maximum number of cached entries before LRU eviction
CACHE_MAX_SIZE=2048

# ── Webhook Alerting ─────────────────────────────────────────────
# Optional: HTTP endpoint to receive alert payloads (JSON POST)
ALERT_WEBHOOK_URL=
# Minimum threat score (0-100) that triggers a webhook notification
ALERT_THREAT_THRESHOLD=75

# ── HTTP Transport ───────────────────────────────────────────────
# Max outbound OSINT requests per minute across all transforms
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Per-request HTTP timeout in seconds
HTTP_TIMEOUT_SECONDS=10.0

# ── Web UI ───────────────────────────────────────────────────────
# Serve the interactive graph dashboard at /ui (true/false)
UI_ENABLED=true

# ── Phase 5: Active Recon (Opt-in) ───────────────────────────────
# Enable active recon transforms (TLS handshakes, banner grabbing)
# CAUTION: Performs direct TCP/TLS connections to target infrastructure.
ACTIVE_RECON=false
ACTIVE_RECON_RATE_LIMIT=1.0

# ── Phase 5: Smart Pivot Agent & LLM ─────────────────────────────
# Enable heuristic-guided transform selection instead of blind BFS
SMART_PIVOT=false
SMART_PIVOT_TOP_K=3

# Generic OpenAI-compatible LLM endpoint for autonomous pivot ranking (optional)
# Local Ollama: http://localhost:11434/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
